# Producao em Massa (Content Studio). Desligado por padrao: com false a API
# inteira responde 404 e nada deste modulo e tocado.
MASS_CONTENT_STUDIO_ENABLED=false

MASS_ADMIN_TOKEN=troque-por-um-token-local-longo
MASS_OPERATOR_TOKEN=
MASS_REVIEWER_TOKEN=

# Onde ficam os projetos (downloads/, editados/, exports/)
MASS_PROJECTS_DIR=botlive-mass/data/projetos
MASS_DATABASE_PATH=botlive-mass/data/massa.db

# Download
MASS_DOWNLOAD_TIMEOUT=900
MASS_DOWNLOAD_TENTATIVAS=3
# Cookies do proprio dono, quando o conteudo exige sessao.
MASS_COOKIES_FILE=

# Edicao
MASS_FFMPEG=ffmpeg
MASS_FFPROBE=ffprobe
MASS_EDIT_TIMEOUT=1800
# Quantos videos o editor processa por rodada
MASS_EDITOR_WORKERS=2

# Exportacao
MASS_ZIP_MAX_GB=8

# Postagem
MASS_PUBLISH_ENABLED=false
# api  = Graph API oficial (recomendado, nao arrisca a conta)
# local = navegador com Playwright (vai contra os termos do Instagram)
MASS_PUBLISHER_MODE=api
LOCAL_PUBLISHER_DRY_RUN=true
MASS_PUBLISH_INTERVALO=300
MASS_SESSIONS_DIR=botlive-mass/data/sessoes
