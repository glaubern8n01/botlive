ROBO_SUPABASE_URL=
ROBO_SUPABASE_KEY=
ROBO_SUPABASE_CLIPS_TABLE=dark_gta_clips

# Opcional para Twitch.
# Sem esses campos, o robo tenta ler chats publicos via IRC anonimo justinfan.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# IA de texto para a legenda clickbait do modulo de publicacao (OPCIONAL).
# Sem chave, o pipeline usa a legenda padrao e segue normal (nunca quebra).
#
# Ordem de uso: chaves Gemini (da esquerda para a direita), depois PUBLISH_AI_*.
# Separe varias chaves Gemini por virgula, sem aspas.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# PUBLISH_AI_PROVIDER: anthropic ou openai (formato OpenAI-compatible).
# Sem esse campo, detecta sozinho: chave sk-ant-* ou URL anthropic -> anthropic.
#
# Anthropic (Claude) - claude-haiku-4-5 e o modelo mais barato e resolve bem:
#   PUBLISH_AI_PROVIDER=anthropic
#   PUBLISH_AI_MODEL=claude-haiku-4-5
#   (PUBLISH_AI_BASE_URL opcional; padrao https://api.anthropic.com)
#
# OpenAI-compatible:
#   OpenAI:     PUBLISH_AI_BASE_URL=https://api.openai.com/v1        PUBLISH_AI_MODEL=gpt-4o-mini
#   DeepSeek:   PUBLISH_AI_BASE_URL=https://api.deepseek.com/v1      PUBLISH_AI_MODEL=deepseek-chat
#   Groq:       PUBLISH_AI_BASE_URL=https://api.groq.com/openai/v1   PUBLISH_AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter: PUBLISH_AI_BASE_URL=https://openrouter.ai/api/v1     PUBLISH_AI_MODEL=deepseek/deepseek-chat
PUBLISH_AI_PROVIDER=
PUBLISH_AI_API_KEY=
PUBLISH_AI_BASE_URL=
PUBLISH_AI_MODEL=
PUBLISH_AI_TIMEOUT_SECONDS=25
# Opcional: legenda fixa usada quando a IA esta desligada ou falha.
PUBLISH_AI_FALLBACK_LEGENDA=

# Instagram/Reels (plugin instagram_publisher.py — Instagram API with Instagram Login).
# IG_APP_SECRET: secret do app em developers.facebook.com; usado so para trocar
# o token do painel por long-lived (60 dias). O token em si vive em
# .tokens/instagram/<conta>.json (gitignored), criado por:
#   python instagram_publisher.py autorizar --conta principal
IG_APP_ID=
IG_APP_SECRET=

# Funcionalidades novas: todas desligadas por padrao para preservar o legado.
MULTI_PROFILE_ENABLED=0
PUBLICATION_QUEUE_ENABLED=0
NEW_PUBLISHER_CONTRACT_ENABLED=0
KWAI_ENABLED=0
KWAI_API_ENABLED=0
CUT_ENABLED=0
NARRASTARS_ENABLED=0

# Exemplo de secret composto para um platform_accounts.secret_ref =
# "env:KWAI_ACCOUNT_PRINCIPAL". Nunca commitar o valor real.
# KWAI_ACCOUNT_PRINCIPAL={"app_id":"...","access_token":"..."}
