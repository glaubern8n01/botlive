# Importar / Adaptar / Publicar. Modulo desligado por padrao: com false a API
# inteira responde 404 e nada e importado.
IMPORT_ADAPT_PUBLISH_ENABLED=false

# Download automatico (yt-dlp e afins). Segundo interruptor: alem desta flag,
# a fonte precisa estar marcada com allow_download. Nada aqui remove marca
# d'agua, credito ou protecao tecnica.
IMPORT_ALLOW_DOWNLOAD=false

IMPORT_ADMIN_TOKEN=troque-por-um-token-local-longo
IMPORT_OPERATOR_TOKEN=troque-por-um-token-local-longo
IMPORT_REVIEWER_TOKEN=troque-por-um-token-local-longo

IMPORT_DATABASE_PATH=botlive-import/data/import.db
IMPORT_FFPROBE=ffprobe
IMPORT_FFPROBE_TIMEOUT=20
IMPORT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
