# Respondedor de comentarios ("ManyChat proprio"). Desligado por padrao.
DM_ENABLED=false

# Com true, casa a regra e mostra o texto que mandaria, sem enviar nada.
# Use assim ate ver as respostas certas no log.
DM_DRY_RUN=true

# Tetos por conta. Evitam parecer spam e protegem o limite da Meta.
DM_MAX_POR_HORA=20
DM_MAX_POR_DIA=150

DM_DATABASE_PATH=botlive-dm/data/dm.db

# O token vem de .tokens/instagram/<conta>.json, o mesmo que o
# instagram_publisher ja usa. Nao ha token novo para gerenciar.
