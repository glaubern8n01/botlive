# URL do projeto Supabase e chave ANON (publishable) — Supabase Studio >
# Settings > API. NUNCA usar a service key aqui: tudo que entra em VITE_*
# vai parar no bundle do navegador.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Senha do painel (checagem client-side simples; ver "Seguranca" no README).
VITE_DASHBOARD_PASSWORD="admin"

# Shop LIVE permanece invisível e inativo por padrão.
VITE_SHOP_LIVE_ENABLED=false
VITE_SHOP_LIVE_API_URL="http://127.0.0.1:8765"

# Campanhas de Cortes permanece invisível e inativo por padrão.
VITE_CAMPAIGNS_ENABLED=false
VITE_CAMPAIGNS_API_URL="http://127.0.0.1:8775"

# Aba multi-canais do VexPublish (nome provisório "Canais de publicação").
# Invisível e inativa por padrão. Não confundir com /canais, que lista os
# canais Twitch vigiados.
VITE_MULTICHANNEL_ENABLED=false
VITE_VEXPUBLISH_API_URL="http://127.0.0.1:8785"

# Importar / Adaptar / Publicar. Invisível e inativo por padrão.
VITE_IMPORT_ENABLED=false
VITE_IMPORT_API_URL="http://127.0.0.1:8795"

# Commerce Studio (TikTok Shop / Shopee). Invisível e inativo por padrão.
# Não substitui o Shop LIVE: a extensão de LIVE continua na aba própria.
VITE_COMMERCE_ENABLED=false
VITE_COMMERCE_API_URL="http://127.0.0.1:8805"

# Na VPS o painel serve os agentes no MESMO dominio (nginx faz proxy), entao
# as URLs sao relativas. Em dev local aponte para 127.0.0.1:<porta>.
