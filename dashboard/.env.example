# URL do projeto Supabase e chave ANON (publishable) — Supabase Studio >
# Settings > API. NUNCA usar a service key aqui: tudo que entra em VITE_*
# vai parar no bundle do navegador.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Senha do painel (checagem client-side simples; ver "Seguranca" no README).
VITE_DASHBOARD_PASSWORD="admin"

# URL pública do serviço OAuth/políticas; jamais coloque Client Secret ou tokens em VITE_*.
VITE_TIKTOK_AUTH_BASE_URL=""
VITE_TIKTOK_STANDARD_API_ENABLED="0"
VITE_TIKTOK_STANDARD_UPLOAD_DRAFT_ENABLED="0"
VITE_TIKTOK_STANDARD_DIRECT_POST_ENABLED="0"
