# URL do projeto Supabase e chave ANON (publishable) — Supabase Studio >
# Settings > API. NUNCA usar a service key aqui: tudo que entra em VITE_*
# vai parar no bundle do navegador.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Senha do painel (checagem client-side simples; ver "Seguranca" no README).
VITE_DASHBOARD_PASSWORD="admin"

# Shop LIVE permanece invisível e inativo por padrão.
VITE_SHOP_LIVE_ENABLED=false
VITE_SHOP_LIVE_API_URL="http://127.0.0.1:8765"

# Campanhas de Cortes permanece invisível e inativo por padrão.
VITE_CAMPAIGNS_ENABLED=false
VITE_CAMPAIGNS_API_URL="http://127.0.0.1:8775"
