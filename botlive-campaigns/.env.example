CAMPAIGNS_ENABLED=false
CAMPAIGNS_DRY_RUN=true
CAMPAIGNS_PAUSED=false
CAMPAIGNS_LOCAL_TOKEN=replace-with-a-long-random-local-token
CAMPAIGNS_ADMIN_TOKEN=replace-with-a-long-random-admin-token
CAMPAIGNS_OPERATOR_TOKEN=replace-with-a-long-random-operator-token
CAMPAIGNS_REVIEWER_TOKEN=replace-with-a-long-random-reviewer-token
CAMPAIGNS_DATABASE_PATH=botlive-campaigns/data/campaigns.db
CAMPAIGNS_MEDIA_ROOT=botlive-campaigns/data/media
CAMPAIGNS_MAX_UPLOAD_BYTES=524288000
CAMPAIGNS_WORKER_CONCURRENCY=1
CAMPAIGNS_FFPROBE=ffprobe
CAMPAIGNS_FFPROBE_TIMEOUT=20
CAMPAIGNS_ORPHAN_SECONDS=120
CAMPAIGNS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
