# Stack local de midia. Nada aqui liga sozinho.

# Perfil de hardware: LOW_RESOURCE | BALANCED | QUALITY.
# O padrao e o mais conservador de proposito: modelo gigante so entra depois
# de avaliar a maquina.
MEDIA_PROFILE=LOW_RESOURCE

# Onde ficam os resultados de auditoria das ferramentas.
MEDIA_AUDIT_PATH=botlive-media/data/auditorias.json
