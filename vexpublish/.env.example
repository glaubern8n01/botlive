# VexPublish - tudo nasce desligado e em dry-run. Copie para .env e ajuste.

BOTLIVE_MULTICHANNEL_ENABLED=false

VEXPUBLISH_ENABLED=false
VEXPUBLISH_DRY_RUN=true
VEXPUBLISH_AUTO_PUBLISH=false
VEXPUBLISH_REQUIRE_APPROVAL=true

VEXPUBLISH_TIKTOK_ENABLED=false
VEXPUBLISH_INSTAGRAM_ENABLED=false
VEXPUBLISH_YOUTUBE_ENABLED=false
VEXPUBLISH_KWAI_ENABLED=false

IMPORT_ADAPT_PUBLISH_ENABLED=false

# Retentativas e recuperacao
VEXPUBLISH_MAX_ATTEMPTS=3
VEXPUBLISH_BACKOFF_BASE_SECONDS=30
VEXPUBLISH_BACKOFF_MAX_SECONDS=3600
VEXPUBLISH_ORPHAN_SECONDS=300

# Caminhos isolados (nao apontar para campaigns.db nem para o banco do BotLive)
VEXPUBLISH_DATABASE_PATH=vexpublish/data/vexpublish.db
VEXPUBLISH_SESSIONS_DIR=vexpublish/data/sessions

# API local (aba de canais no dashboard). A aba aparece com multi-canais ligado;
# gerenciar canal/conta nao publica nada.
VEXPUBLISH_ADMIN_TOKEN=troque-por-um-token-local-longo
VEXPUBLISH_OPERATOR_TOKEN=troque-por-um-token-local-longo
VEXPUBLISH_REVIEWER_TOKEN=troque-por-um-token-local-longo
VEXPUBLISH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Quotas globais, acima dos limites por conta. 0 = sem teto.
# O disco tem piso de proposito: ficar sem espaco no meio de um upload ja
# derrubou a operacao inteira uma vez.
VEXPUBLISH_MAX_JOBS_PER_HOUR=0
VEXPUBLISH_MAX_QUEUE_DEPTH=0
VEXPUBLISH_MAX_PUBLISHING=0
VEXPUBLISH_MIN_FREE_DISK_GB=5
