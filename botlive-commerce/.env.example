# Commerce Studio (TikTok Shop / Shopee). Desligado por padrao.
COMMERCE_ENABLED=false

# Travas do documento. Nao mexer sem motivo:
# auto-publish nao e suportado nesta fase e a fila recusa se estiver ligado.
COMMERCE_AUTO_PUBLISH=false
COMMERCE_REQUIRE_APPROVAL=true
COMMERCE_DRY_RUN=true

COMMERCE_ADMIN_TOKEN=troque-por-um-token-local-longo
COMMERCE_OPERATOR_TOKEN=troque-por-um-token-local-longo
COMMERCE_REVIEWER_TOKEN=troque-por-um-token-local-longo

# Banco proprio. NUNCA apontar para shop-live.db (o Live Pilot e dono dele).
COMMERCE_DATABASE_PATH=botlive-commerce/data/commerce.db
COMMERCE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Entrega ao Live Pilot. O Commerce Studio fala com ele por HTTP, nas rotas
# que ele ja expoe - nunca pelo banco. Sem o token, a entrega real e recusada.
SHOP_LIVE_API_URL=http://127.0.0.1:8765
SHOP_LIVE_LOCAL_TOKEN=
